__pycache__
.claude
.vscode
.venv
.vs
data
build
model
mapgen
checkpoints
checkpoints2
*.npz
*.exe
*.wasm
extern
vcpkg-overlays
vendor
vendor-local-backup
# ...except project17, which pins its deps as git submodules so the renderer
# builds from a clean clone.
!projects/project17-gaussian-renderer/vendor/
.clang-format

# emscripten out-of-source build (fetches and builds raylib, ~500MB)
build-web/

# the wasm rule above is for build artifacts; the demo bundles actually served
# by nginx have to be committed
!site/demos/**/*.wasm
