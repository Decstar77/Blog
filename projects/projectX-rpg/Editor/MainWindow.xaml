<Window x:Class="Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        Title="projectX-rpg Editor" Width="1600" Height="900" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{StaticResource WindowBrush}" Padding="2,0">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Click="Exit_Click" InputGestureText="Alt+F4" />
            </MenuItem>
            <MenuItem x:Name="WindowMenu" Header="_Window" SubmenuOpened="WindowMenu_SubmenuOpened">
                <!-- Filled on open with one toggle per dockable panel -->
                <MenuItem Header="(panels)" />
            </MenuItem>
        </Menu>

        <!--
            Default layout. Each panel's ContentId is its identity for saving/restoring layouts, so keep them stable.
            Contents are attached in MainWindow.xaml.cs; anything still empty is a stub.
        -->
        <ad:DockingManager x:Name="DockManager" AllowMixedOrientation="True">
            <ad:LayoutRoot>
                <ad:LayoutPanel Orientation="Vertical">
                    <ad:LayoutPanel Orientation="Horizontal">
                        <ad:LayoutAnchorablePane DockWidth="260">
                            <ad:LayoutAnchorable ContentId="hierarchy" Title="Hierarchy" CanClose="False" />
                        </ad:LayoutAnchorablePane>

                        <ad:LayoutDocumentPane>
                            <ad:LayoutDocument ContentId="viewport" Title="Viewport" CanClose="False" />
                        </ad:LayoutDocumentPane>

                        <ad:LayoutAnchorablePane DockWidth="320">
                            <ad:LayoutAnchorable ContentId="inspector" Title="Inspector" CanClose="False" />
                        </ad:LayoutAnchorablePane>
                    </ad:LayoutPanel>

                    <ad:LayoutAnchorablePane DockHeight="320">
                        <ad:LayoutAnchorable ContentId="assetBrowser" Title="Asset Browser" CanClose="False" />
                        <ad:LayoutAnchorable ContentId="console" Title="Console" CanClose="False" />
                    </ad:LayoutAnchorablePane>
                </ad:LayoutPanel>
            </ad:LayoutRoot>
        </ad:DockingManager>
    </DockPanel>
</Window>
