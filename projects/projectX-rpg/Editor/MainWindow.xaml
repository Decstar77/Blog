<Window x:Class="Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        Title="projectX-rpg Editor" Width="1600" Height="900" WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <!-- Custom chrome: the OS title bar is replaced by one compact row that also hosts the menu (VS-style). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Compact top-level menu items for the title bar. Fluent's template is too tall to fit the 30px row;
             dropdown items still use the stock Fluent style. -->
        <Style x:Key="TopMenuItem" TargetType="MenuItem">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <Grid>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                                <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="{StaticResource TileBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="2">
                                        <StackPanel IsItemsHost="True" Grid.IsSharedSizeScope="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Maximized WindowChrome windows overhang the screen by the resize border; MainWindow pads this to compensate. -->
    <Border x:Name="RootBorder">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="30" Background="{StaticResource ToolbarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Menu Grid.Column="0" Background="Transparent" Padding="4,0" Margin="0" VerticalAlignment="Center"
                  WindowChrome.IsHitTestVisibleInChrome="True" ItemContainerStyle="{StaticResource TopMenuItem}">
                <MenuItem Header="_File">
                    <MenuItem Header="E_xit" Click="Exit_Click" InputGestureText="Alt+F4" />
                </MenuItem>
                <MenuItem x:Name="WindowMenu" Header="_Window" SubmenuOpened="WindowMenu_SubmenuOpened">
                    <!-- Filled on open with one toggle per dockable panel -->
                    <MenuItem Header="(panels)" />
                </MenuItem>
            </Menu>

            <TextBlock Grid.Column="2" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" />

            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" />
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE923;" Click="Maximize_Click" ToolTip="Restore Down" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Exit_Click" ToolTip="Close" />
            </StackPanel>
        </Grid>

        <!--
            Default layout. Each panel's ContentId is its identity for saving/restoring layouts, so keep them stable.
            Contents are attached in MainWindow.xaml.cs; anything still empty is a stub.
        -->
        <ad:DockingManager x:Name="DockManager" AllowMixedOrientation="True">
            <ad:LayoutRoot>
                <ad:LayoutPanel Orientation="Vertical">
                    <ad:LayoutPanel Orientation="Horizontal">
                        <ad:LayoutAnchorablePane DockWidth="260">
                            <ad:LayoutAnchorable ContentId="hierarchy" Title="Hierarchy" CanClose="False" />
                        </ad:LayoutAnchorablePane>

                        <ad:LayoutDocumentPane>
                            <ad:LayoutDocument ContentId="viewport" Title="Viewport" CanClose="False" />
                        </ad:LayoutDocumentPane>

                        <ad:LayoutAnchorablePane DockWidth="320">
                            <ad:LayoutAnchorable ContentId="inspector" Title="Inspector" CanClose="False" />
                        </ad:LayoutAnchorablePane>
                    </ad:LayoutPanel>

                    <ad:LayoutAnchorablePane DockHeight="320">
                        <ad:LayoutAnchorable ContentId="assetBrowser" Title="Asset Browser" CanClose="False" />
                        <ad:LayoutAnchorable ContentId="console" Title="Console" CanClose="False" />
                    </ad:LayoutAnchorablePane>
                </ad:LayoutPanel>
            </ad:LayoutRoot>
        </ad:DockingManager>
    </DockPanel>
    </Border>
</Window>
