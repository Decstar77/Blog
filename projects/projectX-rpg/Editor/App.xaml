<Application x:Class="Editor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Editor palette, picked to sit next to AvalonDock's VS2013 dark theme -->
        <SolidColorBrush x:Key="WindowBrush"   Color="#1E1E1E" />
        <SolidColorBrush x:Key="PanelBrush"    Color="#252526" />
        <SolidColorBrush x:Key="ToolbarBrush"  Color="#2D2D30" />
        <SolidColorBrush x:Key="TileBrush"     Color="#1B1B1C" />
        <SolidColorBrush x:Key="BorderBrush"   Color="#3F3F46" />
        <SolidColorBrush x:Key="HoverBrush"    Color="#3E3E40" />
        <SolidColorBrush x:Key="SelectedBrush" Color="#094771" />
        <SolidColorBrush x:Key="AccentBrush"   Color="#007ACC" />
        <SolidColorBrush x:Key="TextBrush"     Color="#E8E8E8" />
        <SolidColorBrush x:Key="TextDimBrush"  Color="#9A9A9A" />

        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    </Application.Resources>
</Application>
