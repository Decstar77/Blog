<Application x:Class="Editor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Editor palette, picked to sit next to AvalonDock's VS2013 light theme -->
        <SolidColorBrush x:Key="WindowBrush"   Color="#EEEEF2" />
        <SolidColorBrush x:Key="PanelBrush"    Color="#F5F5F5" />
        <SolidColorBrush x:Key="ToolbarBrush"  Color="#E7E8EC" />
        <SolidColorBrush x:Key="TileBrush"     Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush"   Color="#CCCEDB" />
        <SolidColorBrush x:Key="HoverBrush"    Color="#E0E3E8" />
        <SolidColorBrush x:Key="SelectedBrush" Color="#CCE4F7" />
        <SolidColorBrush x:Key="AccentBrush"   Color="#007ACC" />
        <SolidColorBrush x:Key="TextBrush"     Color="#1E1E1E" />
        <SolidColorBrush x:Key="TextDimBrush"  Color="#6D6D6D" />

        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    </Application.Resources>
</Application>
