<UserControl x:Class="Editor.Panels.AssetBrowser.AssetBrowserPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Editor.Panels.AssetBrowser"
             Background="{StaticResource PanelBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Small square icon button for the toolbar -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource SelectedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="ItemMenu">
            <MenuItem Header="Cook" Command="{Binding CookCommand}" InputGestureText="Enter" />
            <MenuItem Header="Copy resource name" Command="{Binding CopyResourceNameCommand}" InputGestureText="Ctrl+Shift+C" />
            <Separator />
            <MenuItem Header="Open with default app" Command="{Binding OpenCommand}" />
            <MenuItem Header="Show in Explorer" Command="{Binding ShowInExplorerCommand}" />
            <Separator />
            <MenuItem Header="Refresh" Command="{Binding RefreshCommand}" InputGestureText="F5" />
        </ContextMenu>

        <!-- Tile container: flat highlight instead of the default list row chrome -->
        <Style x:Key="TileContainer" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="ToolTip" Value="{Binding ResourceName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource SelectedBrush}" />
                                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TileTemplate" DataType="{x:Type local:AssetItem}">
            <StackPanel Width="{Binding DataContext.TileSize, RelativeSource={RelativeSource AncestorType=ListBox}}">
                <Grid Height="{Binding DataContext.TileSize, RelativeSource={RelativeSource AncestorType=ListBox}}">
                    <Border Background="{StaticResource TileBrush}" CornerRadius="3" />

                    <!-- Type glyph, shown until (or instead of) a thumbnail -->
                    <Viewbox Margin="22">
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Folder">
                                            <Setter Property="Foreground" Value="#DCB67A" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Image">
                                            <Setter Property="Foreground" Value="#6FB3E0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Audio">
                                            <Setter Property="Foreground" Value="#C586C0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Model">
                                            <Setter Property="Foreground" Value="#89D185" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Archive">
                                            <Setter Property="Foreground" Value="#CE9178" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Viewbox>

                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="NearestNeighbor" />

                    <!-- Extension tag -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3" Padding="3,0"
                            Background="#B0000000" CornerRadius="2">
                        <TextBlock Text="{Binding Extension}" FontSize="9" Foreground="{StaticResource TextDimBrush}" />
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- Cook state dot -->
                    <Ellipse Width="8" Height="8" Margin="4" HorizontalAlignment="Right" VerticalAlignment="Top" StrokeThickness="1.5">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CookState}" Value="Cooked">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Fill" Value="#4EC9B0" />
                                        <Setter Property="ToolTip" Value="Cooked" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CookState}" Value="Stale">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Fill" Value="#D7BA7D" />
                                        <Setter Property="ToolTip" Value="Source changed since last cook" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CookState}" Value="Uncooked">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Stroke" Value="{StaticResource TextBrush}" />
                                        <Setter Property="Fill" Value="#C0000000" />
                                        <Setter Property="ToolTip" Value="Not cooked" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>

                <TextBlock Text="{Binding Name}" Margin="0,4,0,0" FontSize="11" TextAlignment="Center"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30" />
                <TextBlock Text="{Binding Location}" FontSize="9" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextDimBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Location}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding UpCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding BackCommand}" />
        <KeyBinding Key="C" Modifiers="Ctrl+Shift" Command="{Binding CopyResourceNameCommand}" />
    </UserControl.InputBindings>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="4,3">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolButton}" Content="&#xE72B;" Command="{Binding BackCommand}" ToolTip="Back (Alt+Left)" />
                    <Button Style="{StaticResource ToolButton}" Content="&#xE74A;" Command="{Binding UpCommand}" ToolTip="Up (Alt+Up)" />
                    <Button Style="{StaticResource ToolButton}" Content="&#xE72C;" Command="{Binding RefreshCommand}" ToolTip="Refresh (F5)" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource TextDimBrush}"
                               VerticalAlignment="Center" Margin="8,0,4,0" ToolTip="Tile size" />
                    <Slider Width="90" Minimum="56" Maximum="200" Value="{Binding TileSize}" VerticalAlignment="Center"
                            IsMoveToPointEnabled="True" Focusable="False" />

                    <Grid Width="200" Margin="10,0,0,0">
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" Padding="22,2,4,2" MinHeight="24" Height="26">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="11" IsHitTestVisible="False"
                                   Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="7,0,0,0" />
                        <TextBlock Text="Search this folder (Ctrl+F)" IsHitTestVisible="False" Margin="23,0,0,0" FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"
                                   Visibility="{Binding Text.IsEmpty, ElementName=SearchBox, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </StackPanel>

                <TextBlock Text="{Binding Breadcrumb}" VerticalAlignment="Center" Margin="8,0" FontSize="12"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentPath}" />
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource ToolbarBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="8,2">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource TextDimBrush}">
                    <Run Text="●" Foreground="#4EC9B0" /> cooked
                    <Run Text="   ●" Foreground="#D7BA7D" /> stale
                    <Run Text="   ○" /> not cooked
                </TextBlock>
                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Folder tree -->
            <TreeView x:Name="FolderTree" Grid.Column="0" ItemsSource="{Binding Roots}" Background="Transparent"
                      BorderThickness="0" SelectedItemChanged="FolderTree_SelectedItemChanged">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="Padding" Value="2,1" />
                        <Setter Property="MinHeight" Value="22" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type local:FolderNode}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" Foreground="#DCB67A"
                                       VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

            <!-- Asset tiles -->
            <ListBox x:Name="AssetList" Grid.Column="2" ItemsSource="{Binding Items}" SelectionMode="Extended"
                     Background="Transparent" BorderThickness="0" Padding="4"
                     ItemTemplate="{StaticResource TileTemplate}" ItemContainerStyle="{StaticResource TileContainer}"
                     ContextMenu="{StaticResource ItemMenu}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="AssetList_SelectionChanged"
                     MouseDoubleClick="AssetList_MouseDoubleClick"
                     KeyDown="AssetList_KeyDown">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource TextDimBrush}" IsHitTestVisible="False" Text="Empty">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DockPanel>
</UserControl>
