<UserControl x:Class="Editor.Panels.Inspector.InspectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PanelBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="10">
            <TextBlock x:Name="Title" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Text="Nothing selected" />
            <TextBlock x:Name="Subtitle" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,10" TextWrapping="Wrap" />

            <Border x:Name="PreviewFrame" Background="{StaticResource TileBrush}" CornerRadius="3" Padding="6"
                    Margin="0,0,0,10" Visibility="Collapsed">
                <Image x:Name="Preview" Stretch="Uniform" MaxHeight="256" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>

            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Key}" FontSize="11" Foreground="{StaticResource TextDimBrush}" />
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" FontSize="11"
                                     TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0"
                                     Foreground="{StaticResource TextBrush}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
